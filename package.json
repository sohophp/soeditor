{
    "name": "soeditor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.20.0",
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "scripts": {
        "build": "pnpm -r --if-present run build",
        "changeset": "changeset",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . && prettier --check .",
        "test": "pnpm test:unit && pnpm test:consumer && pnpm test:browser",
        "test:browser": "playwright test",
        "test:consumer": "pnpm --filter @soeditor/core --filter @soeditor/html --filter @soeditor/engine --filter @soeditor/rich-text --filter @soeditor/source build && node scripts/test-nodenext-consumer.mjs",
        "test:unit": "pnpm --filter @soeditor/core --filter @soeditor/html --filter @soeditor/engine --filter @soeditor/rich-text --filter @soeditor/source test",
        "test:coverage": "pnpm --filter @soeditor/core test:coverage",
        "typecheck": "pnpm -r --if-present run typecheck"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@eslint/js": "^9.34.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.18.0",
        "eslint": "^9.34.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0",
        "vite": "^7.1.3",
        "vitest": "^3.2.4"
    }
}
