{
    "name": "@soeditor/editor",
    "version": "1.1.0",
    "license": "MIT",
    "description": "Developer-first, HTML-first extensible content editor.",
    "keywords": [
        "content-editor",
        "html",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/soeditor"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": [
        "*.css",
        "./dist/soeditor.global.js"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/soeditor.css"
    },
    "scripts": {
        "build": "vite build && vite build --config vite.global.config.ts && tsc -p tsconfig.build.json",
        "test": "vitest run --passWithNoTests",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@soeditor/adapter-sofinder": "workspace:*",
        "@soeditor/comments": "workspace:*",
        "@soeditor/core": "workspace:*",
        "@soeditor/dev-tools": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/file-manager": "workspace:*",
        "@soeditor/html": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/layout": "workspace:*",
        "@soeditor/markdown": "workspace:*",
        "@soeditor/presets": "workspace:*",
        "@soeditor/preview": "workspace:*",
        "@soeditor/projections": "workspace:*",
        "@soeditor/revisions": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*",
        "@soeditor/workspace": "workspace:*",
        "@soeditor/wysiwyg": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "typescript": "^5.9.2",
        "vite": "^7.1.3",
        "vitest": "^3.2.4"
    }
}
