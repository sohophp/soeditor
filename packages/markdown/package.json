{
    "name": "@soeditor/markdown",
    "version": "0.5.1",
    "license": "MIT",
    "description": "Canonical Markdown editing, rendering, and conversion for SoEditor.",
    "keywords": [
        "content-editor",
        "html",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/markdown"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@codemirror/lang-markdown": "6.5.2",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.9",
        "codemirror": "^6.0.2",
        "micromark": "4.0.2",
        "turndown": "7.2.4"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/html": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/html": "workspace:*",
        "@types/turndown": "5.0.6"
    }
}
