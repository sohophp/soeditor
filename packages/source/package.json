{
    "name": "@soeditor/source",
    "version": "0.0.0",
    "description": "CodeMirror-powered HTML source editing for SoEditor.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lint": "^6.9.7",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.9",
        "codemirror": "^6.0.2"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/html": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/html": "workspace:*"
    }
}
