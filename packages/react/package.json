{
    "name": "@soeditor/react",
    "version": "1.1.0",
    "license": "MIT",
    "description": "React lifecycle adapter for SoEditor Workspace.",
    "keywords": [
        "content-editor",
        "react",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/react"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/workspace": "workspace:*",
        "react": ">=18.2.0 <20"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/workspace": "workspace:*",
        "@types/react": "19.2.18",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "@types/react-dom": "19.2.5"
    }
}
