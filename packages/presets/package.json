{
    "name": "@soeditor/presets",
    "version": "0.5.0",
    "description": "Immutable minimal, classic, developer, and Markdown presets for SoEditor.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./classic": {
            "types": "./dist/classic.d.ts",
            "import": "./dist/classic.js"
        },
        "./developer": {
            "types": "./dist/developer.d.ts",
            "import": "./dist/developer.js"
        },
        "./markdown": {
            "types": "./dist/markdown.d.ts",
            "import": "./dist/markdown.js"
        },
        "./minimal": {
            "types": "./dist/minimal.d.ts",
            "import": "./dist/minimal.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/dev-tools": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/file-manager": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/markdown": "workspace:*",
        "@soeditor/preview": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/dev-tools": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/file-manager": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/markdown": "workspace:*",
        "@soeditor/preview": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    }
}
