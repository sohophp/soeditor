{
    "name": "@soeditor/presets",
    "version": "0.8.0",
    "license": "MIT",
    "description": "Immutable minimal, classic, developer, and Markdown presets for SoEditor.",
    "keywords": [
        "content-editor",
        "html",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/presets"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./classic": {
            "types": "./dist/classic.d.ts",
            "import": "./dist/classic.js"
        },
        "./developer": {
            "types": "./dist/developer.d.ts",
            "import": "./dist/developer.js"
        },
        "./markdown": {
            "types": "./dist/markdown.d.ts",
            "import": "./dist/markdown.js"
        },
        "./minimal": {
            "types": "./dist/minimal.d.ts",
            "import": "./dist/minimal.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/dev-tools": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/file-manager": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/layout": "workspace:*",
        "@soeditor/markdown": "workspace:*",
        "@soeditor/preview": "workspace:*",
        "@soeditor/projections": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/dev-tools": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/file-manager": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/layout": "workspace:*",
        "@soeditor/markdown": "workspace:*",
        "@soeditor/preview": "workspace:*",
        "@soeditor/projections": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    }
}
