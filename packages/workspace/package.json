{
    "name": "@soeditor/workspace",
    "version": "0.8.0",
    "private": true,
    "license": "MIT",
    "description": "Framework-neutral application workspace lifecycle for SoEditor.",
    "keywords": [
        "content-editor",
        "lifecycle",
        "typescript"
    ],
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*"
    }
}
