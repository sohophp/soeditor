{
    "name": "@soeditor/vue",
    "version": "1.4.0",
    "license": "MIT",
    "description": "Vue lifecycle adapter for SoEditor Workspace.",
    "keywords": [
        "content-editor",
        "typescript",
        "vue"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/vue"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cms": {
            "types": "./dist/cms.d.ts",
            "import": "./dist/cms.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/workspace": "workspace:*",
        "vue": "^3.5.0",
        "@soeditor/editor": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/workspace": "workspace:*",
        "@vue/server-renderer": "3.5.42",
        "vue": "3.5.42",
        "@soeditor/editor": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@soeditor/editor": {
            "optional": true
        }
    }
}
