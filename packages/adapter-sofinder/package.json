{
    "name": "@soeditor/adapter-sofinder",
    "version": "0.0.0",
    "description": "Dependency-free SoFinder picker adapter for SoEditor.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/file-manager": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/file-manager": "workspace:*"
    }
}
