{
    "name": "@soeditor/file-manager",
    "version": "0.5.0",
    "description": "Generic file-selection capability and Image integration for SoEditor.",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/ui": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/ui": "workspace:*"
    }
}
