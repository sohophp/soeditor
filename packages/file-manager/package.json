{
    "name": "@soeditor/file-manager",
    "version": "0.5.0",
    "license": "MIT",
    "description": "Generic file-selection capability and Image integration for SoEditor.",
    "keywords": [
        "content-editor",
        "html",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/file-manager"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/ui": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/engine": "workspace:*",
        "@soeditor/rich-text": "workspace:*",
        "@soeditor/ui": "workspace:*"
    }
}
