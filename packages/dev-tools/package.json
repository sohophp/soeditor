{
    "name": "@soeditor/dev-tools",
    "version": "1.1.0",
    "license": "MIT",
    "description": "HTML developer workflows for SoEditor.",
    "keywords": [
        "content-editor",
        "html",
        "typescript"
    ],
    "homepage": "https://github.com/sohophp/soeditor#readme",
    "bugs": {
        "url": "https://github.com/sohophp/soeditor/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sohophp/soeditor.git",
        "directory": "packages/dev-tools"
    },
    "engines": {
        "node": ">=22.14.0 <23"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/html": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    },
    "devDependencies": {
        "@soeditor/core": "workspace:*",
        "@soeditor/html": "workspace:*",
        "@soeditor/html-tools": "workspace:*",
        "@soeditor/source": "workspace:*",
        "@soeditor/ui": "workspace:*"
    }
}
