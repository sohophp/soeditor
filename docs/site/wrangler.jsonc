{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "soeditor-docs",
    "compatibility_date": "2026-03-01",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "soeditor.sohophp.app", "custom_domain": true }],
    "assets": {
        "directory": "./.vitepress/dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
    },
    "env": {
        "preview": {
            "name": "soeditor-docs-preview",
            "workers_dev": true,
            "preview_urls": true,
            "routes": [],
            "assets": {
                "directory": "./.vitepress/dist",
                "html_handling": "auto-trailing-slash",
                "not_found_handling": "404-page",
            },
        },
    },
}
