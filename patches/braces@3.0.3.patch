diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..1a40ba427916fcef404efe7ce0d3eeb792e6eac3
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,23 @@
+'use strict';
+
+// Bound the recursive walkers before entering them. Parent/prev references are
+// deliberately excluded: the parser AST contains those normal back-references.
+const MAX_DEPTH = 100;
+const fail = () => {
+  const error = new RangeError('Brace pattern nesting exceeds the safe depth limit (100)');
+  error.code = 'ERR_BRACES_DEPTH_LIMIT';
+  throw error;
+};
+const assertDepth = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length > 0) {
+    const [node, depth] = pending.pop();
+    if (depth > MAX_DEPTH || seen.has(node)) fail();
+    seen.add(node);
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
+module.exports = { assertDepth, fail, MAX_DEPTH };
